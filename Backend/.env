# Server
PORT=5000
NODE_ENV=production

# MongoDB
MONGODB_URI=mongodb+srv://your_username:your_password@cluster.mongodb.net/gimbie_hospital

# JWT
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRE=7d

# Admin User
ADMIN_EMAIL=admin@gimbiehospital.com
ADMIN_PASSWORD=Gimbie@2026Admin

# Email (Nodemailer)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password

# SMS (Twilio - Optional)
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_token
TWILIO_PHONE=+1234567890

# CORS
CORS_ORIGIN=https://gimbie-hospital.vercel.app
