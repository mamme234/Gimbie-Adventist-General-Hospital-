# ============================================
# SERVER CONFIGURATION
# ============================================
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
TIMEZONE=Africa/Addis_Ababa

# ============================================
# MONGODB DATABASE (REQUIRED)
# ============================================
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/gimbie_hospital
MONGODB_DB=gimbie_hospital

# ============================================
# JWT CONFIGURATION
# ============================================
JWT_SECRET=gimbie-hospital-jwt-secret-key-2024
JWT_REFRESH_SECRET=gimbie-hospital-refresh-secret-key-2024
JWT_EXPIRE=7d
JWT_REFRESH_EXPIRE=30d

# ============================================
# GOOGLE GEMINI AI
# ============================================
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-pro
AI_ENABLED=true

# ============================================
# HOSPITAL INFORMATION
# ============================================
HOSPITAL_NAME=Gimbie Adventist General Hospital
HOSPITAL_WEBSITE=https://gimbiehospital.com
HOSPITAL_EMAIL=info@gimbiehospital.com
HOSPITAL_PHONE=+251-123-456789

# ============================================
# FRONTEND URL
# ============================================
FRONTEND_URL=https://gimbiehospital.com

# ============================================
# FILE UPLOAD
# ============================================
MAX_FILE_SIZE=10485760
MAX_FILES=10
UPLOAD_PATH=./uploads

# ============================================
# SECURITY
# ============================================
BCRYPT_ROUNDS=10
ENCRYPTION_KEY=your-32-byte-encryption-key-here

# ============================================
# CORS
# ============================================
CORS_ORIGINS=*

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=info
